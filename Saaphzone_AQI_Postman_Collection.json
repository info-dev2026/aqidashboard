            "url": {
              "raw": "{{baseUrl}}/ingest",
              "host": ["{{baseUrl}}"],
              "path": ["ingest"]
            },
            "description": "Simulates MAAPS ambient device posting real-time PM2.5, PM10, differential pressure, and rain status. Returns computed AQI and effective fan/power state."
