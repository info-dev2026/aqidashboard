{
  "name": "saaphzone-aqi-portal-monorepo",
  "version": "1.0.0",
  "description": "Saaphzone AQI Monitoring Portal — Decoupled 3-Tier Architecture with PostgreSQL",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix backend install",
    "build": "npm --prefix backend install",
    "start": "node backend/src/server.js",
    "start:both": "node start.js",
    "dev": "node start.js --dev",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend start",
    "frontend:dev": "npm --prefix frontend run dev",
    "db:init": "node database/init.js",
    "db:seed": "node database/seed.js",
    "test:backend": "npm --prefix backend test"
  }
}
