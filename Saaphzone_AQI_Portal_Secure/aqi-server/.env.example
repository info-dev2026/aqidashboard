# Saaphzone AQI Portal — environment configuration
# Copy to ".env" and fill real values. NEVER commit .env to git.

# 32+ character random secret for signing sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

# Session lifetime
TOKEN_TTL=2h

# Set to "production" when deployed behind HTTPS
NODE_ENV=development
PORT=3000

# Initial seed passwords (change, then run: npm run seed)
SEED_ADMIN_PW="ChangeMe#Admin1"   # quote if password contains # or spaces
SEED_SERVICE_PW="ChangeMe#Service1"
SEED_CLIENT_PW="ChangeMe#Client1"
